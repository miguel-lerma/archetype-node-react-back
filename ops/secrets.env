# ops/secrets.env
# Mapeo de variables de entorno a nombres de secretos en Key Vault
# Formato: ENV_VAR=kv-secret-name
#
# IMPORTANTE:
# - Este archivo NO contiene valores reales (solo nombres de secretos)
# - Los valores reales están almacenados en Azure Key Vault
# - Para agregar un nuevo secreto:
#   1. Agregar línea aquí: MI_SECRETO=nombre-en-kv
#   2. Crear el secreto en KV: az keyvault secret set --vault-name itxzakvlab01 --name nombre-en-kv --value "valor"

# ========== Database ==========
DATABASE_URL=db-url
DATABASE_USER=db-user
DATABASE_PASSWORD=db-password

# ========== External APIs (placeholders for future) ==========
OPENAI_API_KEY=openai-key
STRIPE_SECRET_KEY=stripe-secret

# ========== Storage ==========
BLOB_CONNECTION_STRING=blob-connection